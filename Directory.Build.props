<Project>
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <SuiteName Condition="'$(SuiteName)' == ''">PlatformMigrationTests</SuiteName>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build/sdk-obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)build/sdk-bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(MSBuildProjectName)' == 'RegressionTests'">$(MSBuildThisFileDirectory)build/sdk-obj/RegressionTests/$(SuiteName)/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(MSBuildProjectName)' == 'RegressionTests'">$(MSBuildThisFileDirectory)build/sdk-bin/RegressionTests/$(SuiteName)/</BaseOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);SDK_BUILD</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' == 'net10.0-windows'">$(DefineConstants);MODERN_DOTNET</DefineConstants>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseSharedCompilation>false</UseSharedCompilation>
    <RestoreIgnoreFailedSources>false</RestoreIgnoreFailedSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
