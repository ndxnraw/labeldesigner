<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>zxing</AssemblyName>
    <DefineConstants>$(DefineConstants);NET40</DefineConstants>
    <DisableImplicitFrameworkDefines>true</DisableImplicitFrameworkDefines>
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWindowsForms>
    <NoWarn>$(NoWarn);CS0618;SYSLIB0050;SYSLIB0051</NoWarn>
  </PropertyGroup>
  <ItemGroup><Compile Include="ZXingSource/**/*.cs"/></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'"><Reference Include="System.Drawing"/><Reference Include="System.Numerics"/></ItemGroup>
</Project>
